FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn httpx numpy pydantic

COPY mesh/brain.py /app/brain.py
COPY mesh/broker_full.py /app/broker_full.py
COPY mesh/server.py /app/server.py

ENV BRAIN_PORT=8893
ENV BROKER_PORT=8894
ENV GROQ_MODEL=llama-3.3-70b-versatile

EXPOSE 8893 8894

CMD ["uvicorn", "brain:app", "--host", "0.0.0.0", "--port", "8893"]
